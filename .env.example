# Configuration de CyberQuiz RSE

# Adresse IP d'écoute de l'hôte (0.0.0.0 pour toutes interfaces / reverse proxy distant, ou 127.0.0.1 si local)
APP_BIND_IP=0.0.0.0

# Port d'exposition du service sur l'hôte Debian (3000 par défaut)
APP_PORT=3000

# Port d'écoute interne du conteneur
PORT=3000

# Environnement d'exécution (production ou development)
NODE_ENV=production

# Clé secrète cryptographique pour la signature des jetons administrateur JWT
# (Générée automatiquement de manière sécurisée par install.sh via OpenSSL)
JWT_SECRET=remplacez_cette_cle_par_un_secret_aleatoire_tres_long_256bits


